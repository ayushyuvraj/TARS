APP_ENV=development
DATABASE_PATH=backend/data/gst_reconciliation.db
UPLOAD_DIR=backend/data/uploads
FRONTEND_ORIGIN=http://localhost:5173
LLM_PROVIDER=openai
LLM_MAX_REPAIR_ATTEMPTS=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_INVESTIGATION_TIMEOUT_SECONDS=45
AI_INVESTIGATION_MAX_TOOL_CALLS=8
MAPPING_HIGH_CONFIDENCE_THRESHOLD=0.90
MAPPING_MEDIUM_CONFIDENCE_THRESHOLD=0.70
